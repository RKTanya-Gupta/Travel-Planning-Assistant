# MAAS (GenAI Lab) settings. Copy this file to .env and paste your key.
# Check with:  python -m src.llm
MAAS_BASE_URL=https://genailab.tcs.in
MAAS_API_KEY=
MAAS_MODEL=genailab-maas-gpt-5.4
# Other models that work: genailab-maas-gpt-5.4-mini, genailab-maas-gpt-5.1,
# azure_ai/genailab-maas-DeepSeek-V3-0324 (full list: python -m src.llm)

# The lab gateway uses an internal certificate, keep this false inside the lab
MAAS_VERIFY_SSL=false
